diff --git a/drivers/hid/hid-lenovo-spectrum.c b/drivers/hid/hid-lenovo-spectrum.c
new file mode 100644
index 000000000000..e1a37d7f5570
--- /dev/null
+++ b/drivers/hid/hid-lenovo-spectrum.c
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Keyboard backlight brightness driver for Lenovo Legion "Spectrum" RGB keyboards
+ *
+ * Based on the HID protocol reverse-engineered by the LenovoLegionToolkit project:
+ * https://github.com/LenovoLegionToolkit-Team/LenovoLegionToolkit/
+ * (opcodes from LenovoLegionToolkit.Lib/Native.cs)
+ */
+
+#include <linux/device.h>
+#include <linux/hid.h>
+#include <linux/leds.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+
+#include "hid-ids.h"
+
+/*
+ * All commands from the vendor protocol use feature report 7 (960 bytes, zero-padded):
+ * [0x07, op, 0xc0, 0x03, arg]. A query is a SET_REPORT selecting the op, followed by
+ * a GET_REPORT whose reply echoes the op in byte 1 and carries the value in byte 4.
+ */
+#define SPECTRUM_REPORT_ID		0x07
+#define SPECTRUM_REPORT_LEN		960
+
+#define SPECTRUM_HDR_B2			0xc0
+#define SPECTRUM_HDR_B3			0x03
+
+#define SPECTRUM_OP_GET_BRIGHTNESS	0xcd
+#define SPECTRUM_OP_SET_BRIGHTNESS	0xce
+#define SPECTRUM_OP_COMPATIBILITY	0xd1
+
+/*
+ * The keyboard supports off + 3 brightness levels. These are represented by hardware as
+ * { 0, 3, 6, 9 }, mapping to { off, low, medium, high }.
+ */
+#define SPECTRUM_HW_MAX_BRIGHTNESS	9
+#define SPECTRUM_LED_MAX_BRIGHTNESS	3
+#define SPECTRUM_LEVEL_STEP		(SPECTRUM_HW_MAX_BRIGHTNESS / SPECTRUM_LED_MAX_BRIGHTNESS)
+
+/*
+ * Whenever the brightness or the lighting preset changes, the controller sends input
+ * report 5 with the new state:
+ *
+ *   Brightness up:             [0x05, 0x02, brightness]
+ *   Brightness down:           [0x05, 0x03, brightness]
+ *   Preset changed (Fn+Space): [0x05, 0x01, preset], followed by [0x05, 0x02, brightness]
+ *
+ * brightness uses the hardware scale above, preset goes from 1 to 6. The "brightness up"
+ * report is also sent after writes made through this driver. The brightness reports are
+ * used to catch changes not made through this driver, such as Fn+Up/Down. ideapad-laptop
+ * also receives Fn+Up/Down as WMI events; they are handled here instead.
+ */
+#define SPECTRUM_STATE_REPORT_ID	0x05
+#define SPECTRUM_STATE_BRIGHTNESS_UP	0x02
+#define SPECTRUM_STATE_BRIGHTNESS_DOWN	0x03
+
+struct spectrum_kbd {
+	struct hid_device *hdev;
+	struct led_classdev cdev;
+	struct mutex cmd_lock;		/* protects the buffer and SET/GET pairs */
+	u8 *buf;
+	bool initialized;		/* init succeeded: remove() must undo it */
+	spinlock_t level_lock;		/* protects level, shared with raw_event */
+	u8 level;			/* last known LED level (0-3), shared with raw_event */
+};
+
+/*
+ * Send one command. If @reply is true, read the answer back and return the
+ * value byte (pos. 4), otherwise return 0; negative errno on failure.
+ */
+static int spectrum_cmd(struct spectrum_kbd *kbd, u8 op, u8 arg, bool reply)
+{
+	u8 *buf = kbd->buf;
+	int ret;
+
+	lockdep_assert_held(&kbd->cmd_lock);
+
+	memset(buf, 0, SPECTRUM_REPORT_LEN);
+	buf[0] = SPECTRUM_REPORT_ID;
+	buf[1] = op;
+	buf[2] = SPECTRUM_HDR_B2;
+	buf[3] = SPECTRUM_HDR_B3;
+	buf[4] = arg;
+
+	ret = hid_hw_raw_request(kbd->hdev, SPECTRUM_REPORT_ID, buf,
+				 SPECTRUM_REPORT_LEN, HID_FEATURE_REPORT,
+				 HID_REQ_SET_REPORT);
+	if (ret < 0)
+		return ret;
+	if (!reply)
+		return 0;
+
+	ret = hid_hw_raw_request(kbd->hdev, SPECTRUM_REPORT_ID, buf,
+				 SPECTRUM_REPORT_LEN, HID_FEATURE_REPORT,
+				 HID_REQ_GET_REPORT);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Replies echo the op in byte 1. Check for a mismatch, which
+	 * means a hidraw user slipped a request in between our SET and GET.
+	 */
+	if (ret < 5 || buf[1] != op) {
+		hid_dbg(kbd->hdev, "unexpected reply to op 0x%02x: len %d op 0x%02x\n",
+			op, ret, buf[1]);
+		return -EIO;
+	}
+
+	return buf[4];
+}
+
+/*
+ * The controller answers the compatibility query with 0 when it drives the
+ * keyboard lighting, which is what LenovoLegionToolkit checks for. The same
+ * controller is also used on models with a single-color backlight (e.g.
+ * Legion Y9000P IAX10), where it answers 1: there the backlight is controlled
+ * through ACPI and already exposed by ideapad-laptop as platform::kbd_backlight,
+ * so no LED is registered here.
+ */
+static int spectrum_check_compatibility(struct spectrum_kbd *kbd)
+{
+	int ret;
+
+	guard(mutex)(&kbd->cmd_lock);
+
+	ret = spectrum_cmd(kbd, SPECTRUM_OP_COMPATIBILITY, 0, true);
+	if (ret < 0)
+		return ret;
+	if (ret > 0)
+		return -ENODEV;
+
+	return 0;
+}
+
+static u8 spectrum_level_to_hw(u8 level)
+{
+	return min(level * SPECTRUM_LEVEL_STEP, SPECTRUM_HW_MAX_BRIGHTNESS);
+}
+
+/* Values between steps (set via hidraw) round up, so a lit backlight is never reported as off */
+static u8 spectrum_hw_to_level(u8 hw)
+{
+	return min(DIV_ROUND_UP(hw, SPECTRUM_LEVEL_STEP), SPECTRUM_LED_MAX_BRIGHTNESS);
+}
+
+static int spectrum_led_set(struct led_classdev *cdev, enum led_brightness value)
+{
+	struct spectrum_kbd *kbd = container_of(cdev, struct spectrum_kbd, cdev);
+	u8 old;
+	int ret;
+
+	guard(mutex)(&kbd->cmd_lock);
+
+	scoped_guard(spinlock_irqsave, &kbd->level_lock) {
+		old = kbd->level;
+		kbd->level = value;
+	}
+	ret = spectrum_cmd(kbd, SPECTRUM_OP_SET_BRIGHTNESS, spectrum_level_to_hw(value), false);
+	if (ret) {
+		scoped_guard(spinlock_irqsave, &kbd->level_lock)
+			kbd->level = old;
+	}
+
+	return ret;
+}
+
+static enum led_brightness spectrum_led_get(struct led_classdev *cdev)
+{
+	struct spectrum_kbd *kbd = container_of(cdev, struct spectrum_kbd, cdev);
+	u8 level;
+	int ret;
+
+	guard(mutex)(&kbd->cmd_lock);
+
+	ret = spectrum_cmd(kbd, SPECTRUM_OP_GET_BRIGHTNESS, 0, true);
+	if (ret < 0)
+		return ret;
+
+	level = spectrum_hw_to_level(ret);
+	scoped_guard(spinlock_irqsave, &kbd->level_lock)
+		kbd->level = level;
+
+	return level;
+}
+
+static int spectrum_init(struct spectrum_kbd *kbd)
+{
+	struct hid_device *hdev = kbd->hdev;
+	struct hid_report *report;
+	int ret;
+
+	report = hdev->report_enum[HID_FEATURE_REPORT].report_id_hash[SPECTRUM_REPORT_ID];
+	if (!report || hid_report_len(report) != SPECTRUM_REPORT_LEN)
+		return -ENODEV;
+
+	ret = spectrum_check_compatibility(kbd);
+	if (ret)
+		return ret;
+
+	kbd->cdev.name = ":" LED_FUNCTION_KBD_BACKLIGHT;
+	kbd->cdev.max_brightness = SPECTRUM_LED_MAX_BRIGHTNESS;
+	kbd->cdev.brightness_get = spectrum_led_get;
+	kbd->cdev.brightness_set_blocking = spectrum_led_set;
+	kbd->cdev.flags = LED_BRIGHT_HW_CHANGED | LED_RETAIN_AT_SHUTDOWN;
+
+	ret = led_classdev_register(&hdev->dev, &kbd->cdev);
+	if (ret)
+		return ret;
+
+	ret = hid_hw_open(hdev);
+	if (ret) {
+		led_classdev_unregister(&kbd->cdev);
+		return ret;
+	}
+
+	kbd->initialized = true;
+	return 0;
+}
+
+static void spectrum_exit(struct spectrum_kbd *kbd)
+{
+	if (!kbd->initialized)
+		return;
+
+	hid_hw_close(kbd->hdev);
+	led_classdev_unregister(&kbd->cdev);
+	kbd->initialized = false;
+}
+
+static int spectrum_probe(struct hid_device *hdev, const struct hid_device_id *id)
+{
+	struct spectrum_kbd *kbd;
+	int ret;
+
+	kbd = devm_kzalloc(&hdev->dev, sizeof(*kbd), GFP_KERNEL);
+	if (!kbd)
+		return -ENOMEM;
+
+	kbd->buf = devm_kzalloc(&hdev->dev, SPECTRUM_REPORT_LEN, GFP_KERNEL);
+	if (!kbd->buf)
+		return -ENOMEM;
+
+	ret = devm_mutex_init(&hdev->dev, &kbd->cmd_lock);
+	if (ret)
+		return ret;
+
+	spin_lock_init(&kbd->level_lock);
+
+	kbd->hdev = hdev;
+	hid_set_drvdata(hdev, kbd);
+
+	ret = hid_parse(hdev);
+	if (ret)
+		return ret;
+
+	ret = hid_hw_start(hdev, HID_CONNECT_DEFAULT);
+	if (ret)
+		return ret;
+
+	ret = spectrum_init(kbd);
+	if (ret) {
+		if (ret != -ENODEV)
+			hid_warn(hdev, "Could not set up keyboard backlight LED: %d\n", ret);
+		else
+			hid_info(hdev, "Vendor lighting interface not supported\n");
+	}
+
+	return 0;
+}
+
+static void spectrum_remove(struct hid_device *hdev)
+{
+	struct spectrum_kbd *kbd = hid_get_drvdata(hdev);
+
+	spectrum_exit(kbd);
+	hid_hw_stop(hdev);
+}
+
+static int spectrum_raw_event(struct hid_device *hdev, struct hid_report *report,
+			      u8 *data, int size)
+{
+	struct spectrum_kbd *kbd = hid_get_drvdata(hdev);
+	u8 level;
+
+	if (!kbd->initialized || report->id != SPECTRUM_STATE_REPORT_ID || size < 3)
+		return 0;
+	if (data[1] != SPECTRUM_STATE_BRIGHTNESS_UP && data[1] != SPECTRUM_STATE_BRIGHTNESS_DOWN)
+		return 0;
+
+	/*
+	 * The controller also reports the level after our own writes and after
+	 * RGB preset changes; only report actual changes, such as those from Fn+Up/Down.
+	 */
+	level = spectrum_hw_to_level(data[2]);
+	scoped_guard(spinlock_irqsave, &kbd->level_lock) {
+		if (level == kbd->level)
+			return 0;
+		kbd->level = level;
+	}
+	led_classdev_notify_brightness_hw_changed(&kbd->cdev, level);
+
+	return 0;
+}
+
+static const struct hid_device_id spectrum_devices[] = {
+	{ HID_USB_DEVICE(USB_VENDOR_ID_ITE, USB_DEVICE_ID_ITE_LEGION_C197) },
+	{ }
+};
+MODULE_DEVICE_TABLE(hid, spectrum_devices);
+
+static struct hid_driver spectrum_driver = {
+	.name		= "hid-lenovo-spectrum",
+	.id_table	= spectrum_devices,
+	.probe		= spectrum_probe,
+	.remove		= spectrum_remove,
+	.raw_event	= spectrum_raw_event,
+};
+module_hid_driver(spectrum_driver);
+
+MODULE_DESCRIPTION("Lenovo Legion Spectrum keyboard backlight driver");
+MODULE_AUTHOR("Marco Giunta <marco_giunta@outlook.it>");
+MODULE_LICENSE("GPL");
-- 
