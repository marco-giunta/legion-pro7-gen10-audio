From d251c9d8fb554a5afe6afaaf0640047fc91ff918 Mon Sep 17 00:00:00 2001
From: Marco Giunta <marco_giunta@outlook.it>
Date: Sun, 27 Sep 2026 20:48:33 +0200
Subject: [PATCH 1/4] platform/x86: ideapad-laptop: Move notifier declarations
 to include/linux/platform_data/x86

Move ideapad-laptop.h to include/linux/platform_data/x86/ so drivers
outside drivers/platform/x86/lenovo can use the notifier chain.

No functional changes.

Signed-off-by: Marco Giunta <marco_giunta@outlook.it>
---
 MAINTAINERS                                                 | 1 +
 drivers/platform/x86/lenovo/ideapad-laptop.c                | 2 +-
 drivers/platform/x86/lenovo/ymc.c                           | 2 +-
 .../linux/platform_data/x86}/ideapad-laptop.h               | 6 +++---
 4 files changed, 6 insertions(+), 5 deletions(-)
 rename {drivers/platform/x86/lenovo => include/linux/platform_data/x86}/ideapad-laptop.h (78%)

diff --git a/MAINTAINERS b/MAINTAINERS
index 140eafcbbd78..692837e89607 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -12575,6 +12575,7 @@ L:	platform-driver-x86@vger.kernel.org
 S:	Maintained
 W:	http://launchpad.net/ideapad-laptop
 F:	drivers/platform/x86/lenovo/ideapad-laptop.c
+F:	include/linux/platform_data/x86/ideapad-laptop.h
 
 IDEAPAD LAPTOP SLIDEBAR DRIVER
 M:	Andrey Moiseev <o2g.org.ru@gmail.com>
diff --git a/drivers/platform/x86/lenovo/ideapad-laptop.c b/drivers/platform/x86/lenovo/ideapad-laptop.c
index 8213524504ee..4d4b1a58b68e 100644
--- a/drivers/platform/x86/lenovo/ideapad-laptop.c
+++ b/drivers/platform/x86/lenovo/ideapad-laptop.c
@@ -26,6 +26,7 @@
 #include <linux/kernel.h>
 #include <linux/leds.h>
 #include <linux/module.h>
+#include <linux/platform_data/x86/ideapad-laptop.h>
 #include <linux/platform_device.h>
 #include <linux/platform_profile.h>
 #include <linux/power_supply.h>
@@ -35,7 +36,6 @@
 #include <linux/sysfs.h>
 #include <linux/types.h>
 #include <linux/wmi.h>
-#include "ideapad-laptop.h"
 
 #include <acpi/battery.h>
 #include <acpi/video.h>
diff --git a/drivers/platform/x86/lenovo/ymc.c b/drivers/platform/x86/lenovo/ymc.c
index df96107d2501..0a904ec98097 100644
--- a/drivers/platform/x86/lenovo/ymc.c
+++ b/drivers/platform/x86/lenovo/ymc.c
@@ -13,8 +13,8 @@
 #include <linux/dmi.h>
 #include <linux/input.h>
 #include <linux/input/sparse-keymap.h>
+#include <linux/platform_data/x86/ideapad-laptop.h>
 #include <linux/wmi.h>
-#include "ideapad-laptop.h"
 
 #define LENOVO_YMC_EVENT_GUID	"06129D99-6083-4164-81AD-F092F9D773A6"
 #define LENOVO_YMC_QUERY_GUID	"09B0EE6E-C3FD-4243-8DA1-7911FF80BB8C"
diff --git a/drivers/platform/x86/lenovo/ideapad-laptop.h b/include/linux/platform_data/x86/ideapad-laptop.h
similarity index 78%
rename from drivers/platform/x86/lenovo/ideapad-laptop.h
rename to include/linux/platform_data/x86/ideapad-laptop.h
index 1e52f2aa0aac..d0282d31b3d1 100644
--- a/drivers/platform/x86/lenovo/ideapad-laptop.h
+++ b/include/linux/platform_data/x86/ideapad-laptop.h
@@ -6,8 +6,8 @@
  *  Copyright © 2010 David Woodhouse <dwmw2@infradead.org>
  */
 
-#ifndef _IDEAPAD_LAPTOP_H_
-#define _IDEAPAD_LAPTOP_H_
+#ifndef __PLATFORM_DATA_X86_IDEAPAD_LAPTOP_H
+#define __PLATFORM_DATA_X86_IDEAPAD_LAPTOP_H
 
 #include <linux/notifier.h>
 
@@ -19,4 +19,4 @@ int ideapad_laptop_register_notifier(struct notifier_block *nb);
 int ideapad_laptop_unregister_notifier(struct notifier_block *nb);
 void ideapad_laptop_call_notifier(unsigned long action, void *data);
 
-#endif /* !_IDEAPAD_LAPTOP_H_ */
+#endif /* __PLATFORM_DATA_X86_IDEAPAD_LAPTOP_H */
