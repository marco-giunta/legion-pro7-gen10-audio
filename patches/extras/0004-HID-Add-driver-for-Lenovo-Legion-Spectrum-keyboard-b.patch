+++ b/drivers/hid/Kconfig
@@ -661,6 +661,18 @@ config HID_LENOVO_GO_S
 	S. Say M here to compile this driver as a module. The module will be called
 	hid-lenovo-go-s.
 
+config HID_LENOVO_LEGION_SPECTRUM
+	tristate "HID Driver for Lenovo Legion Spectrum keyboard backlight"
+	depends on USB_HID
+	depends on LEDS_CLASS
+	help
+	  Keyboard backlight brightness control for Lenovo Legion laptops
+	  with the ITE 8258 "Spectrum" RGB keyboard, exposed as the
+	  legion::kbd_backlight LED class device.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called hid-lenovo-legion-spectrum.
+
 config HID_LETSKETCH
 	tristate "Letsketch WP9620N tablets"
 	depends on USB_HID
