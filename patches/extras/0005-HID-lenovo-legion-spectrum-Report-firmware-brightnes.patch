From aac0e4bce9000ecfaeaa6a4d3ab48d3cb06d89c8 Mon Sep 17 00:00:00 2001
From: Marco Giunta <marco_giunta@outlook.it>
Date: Sun, 27 Sep 2026 22:17:29 +0200
Subject: [PATCH 3/4] HID: lenovo-legion-spectrum: Report firmware brightness
 changes

Fn+Up/Down changes the keyboard backlight in firmware without sending a
HID report, leaving userspace out of sync. The firmware reports it with
the Legion fn-keys WMI event instead: 0x18 (off), 0x19, 0x1a and 0x26
(levels 1-3).

Forward these events from ideapad-laptop on its notifier chain, and have
the HID driver read back the new level and report it with
led_classdev_notify_brightness_hw_changed().

Fn+Space cycles the firmware's lighting presets (0x20-0x25). There is no
kernel interface for those, so consume them instead of reporting them
as KEY_UNKNOWN.

Signed-off-by: Marco Giunta <marco_giunta@outlook.it>
---
 drivers/hid/Kconfig                           |  1 +
 drivers/hid/hid-lenovo-legion-spectrum.c      | 35 +++++++++++++++++++
 drivers/platform/x86/lenovo/ideapad-laptop.c  | 13 +++++++
 .../linux/platform_data/x86/ideapad-laptop.h  |  1 +
 4 files changed, 50 insertions(+)

diff --git a/drivers/hid/Kconfig b/drivers/hid/Kconfig
index c130bd8a7256..c969c5402466 100644
--- a/drivers/hid/Kconfig
+++ b/drivers/hid/Kconfig
@@ -664,6 +664,7 @@ config HID_LENOVO_GO_S
 config HID_LENOVO_LEGION_SPECTRUM
 	tristate "HID Driver for Lenovo Legion Spectrum keyboard backlight"
 	depends on USB_HID
+	depends on IDEAPAD_LAPTOP
 	depends on LEDS_CLASS
 	help
 	  Keyboard backlight brightness control for Lenovo Legion laptops
diff --git a/drivers/hid/hid-lenovo-legion-spectrum.c b/drivers/hid/hid-lenovo-legion-spectrum.c
index 96094cdbf741..31879a1077ef 100644
--- a/drivers/hid/hid-lenovo-legion-spectrum.c
+++ b/drivers/hid/hid-lenovo-legion-spectrum.c
@@ -11,6 +11,8 @@
 #include <linux/leds.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/notifier.h>
+#include <linux/platform_data/x86/ideapad-laptop.h>
 
 #include "hid-ids.h"
 
@@ -41,6 +43,7 @@
 struct spectrum_kbd {
 	struct hid_device *hdev;
 	struct led_classdev cdev;
+	struct notifier_block nb;
 	struct mutex lock;		/* protects the buffer and SET/GET pairs */
 	u8 *buf;
 	bool initialized;		/* init succeeded: remove() must undo it */
@@ -140,6 +143,29 @@ static enum led_brightness spectrum_led_get(struct led_classdev *cdev)
 	return spectrum_get_brightness_level(kbd);
 }
 
+/*
+ * Called by ideapad-laptop when the firmware changed the brightness.
+ * Read the level back rather than decoding the actual WMI value.
+ */
+static int spectrum_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct spectrum_kbd *kbd = container_of(nb, struct spectrum_kbd, nb);
+	int level;
+
+	if (action != IDEAPAD_LAPTOP_SPECTRUM_KBD_BL_CHANGED)
+		return NOTIFY_DONE;
+
+	level = spectrum_get_brightness_level(kbd);
+	if (level < 0) {
+		hid_warn(kbd->hdev, "Failed to read brightness: %d\n", level);
+		return NOTIFY_DONE;
+	}
+
+	/* Notify even if unchanged: pressing Fn+Up at max still gets an OSD. */
+	led_classdev_notify_brightness_hw_changed(&kbd->cdev, level);
+	return NOTIFY_OK;
+}
+
 static int spectrum_init(struct spectrum_kbd *kbd)
 {
 	struct hid_device *hdev = kbd->hdev;
@@ -164,6 +190,13 @@ static int spectrum_init(struct spectrum_kbd *kbd)
 	if (ret)
 		return ret;
 
+	kbd->nb.notifier_call = spectrum_notify;
+	ret = ideapad_laptop_register_notifier(&kbd->nb);
+	if (ret) {
+		led_classdev_unregister(&kbd->cdev);
+		return ret;
+	}
+
 	kbd->initialized = true;
 	return 0;
 }
@@ -173,6 +206,7 @@ static void spectrum_exit(struct spectrum_kbd *kbd)
 	if (!kbd->initialized)
 		return;
 
+	ideapad_laptop_unregister_notifier(&kbd->nb);
 	led_classdev_unregister(&kbd->cdev);
 	kbd->initialized = false;
 }
@@ -238,6 +272,7 @@ static struct hid_driver spectrum_driver = {
 };
 module_hid_driver(spectrum_driver);
 
+MODULE_IMPORT_NS("IDEAPAD_LAPTOP");
 MODULE_DESCRIPTION("Lenovo Legion Spectrum keyboard backlight driver");
 MODULE_AUTHOR("Marco Giunta <marco_giunta@outlook.it>");
 MODULE_LICENSE("GPL");
diff --git a/drivers/platform/x86/lenovo/ideapad-laptop.c b/drivers/platform/x86/lenovo/ideapad-laptop.c
index 4d4b1a58b68e..36d6416dbac7 100644
--- a/drivers/platform/x86/lenovo/ideapad-laptop.c
+++ b/drivers/platform/x86/lenovo/ideapad-laptop.c
@@ -2308,6 +2308,19 @@ static void ideapad_wmi_notify(struct wmi_device *wdev, union acpi_object *data)
 			break;
 		}
 
+		switch (data->integer.value) {
+		/* Keyboard backlight changed by the firmware (Fn+Up/Down) */
+		case 0x18: /* off */
+		case 0x19: /* level 1 */
+		case 0x1a: /* level 2 */
+		case 0x26: /* level 3 */
+			ideapad_laptop_call_notifier(IDEAPAD_LAPTOP_SPECTRUM_KBD_BL_CHANGED, NULL);
+			return;
+		/* Lighting preset changed by the firmware (Fn+Space), no kernel API yet */
+		case 0x20 ... 0x25:
+			return;
+		}
+
 		/* 0x02 FnLock, 0x03 Esc */
 		if (data->integer.value == 0x02 || data->integer.value == 0x03)
 			ideapad_fn_lock_led_notify(priv, data->integer.value == 0x02);
diff --git a/include/linux/platform_data/x86/ideapad-laptop.h b/include/linux/platform_data/x86/ideapad-laptop.h
index d0282d31b3d1..4ab48184bbb8 100644
--- a/include/linux/platform_data/x86/ideapad-laptop.h
+++ b/include/linux/platform_data/x86/ideapad-laptop.h
@@ -13,6 +13,7 @@
 
 enum ideapad_laptop_notifier_actions {
 	IDEAPAD_LAPTOP_YMC_EVENT,
+	IDEAPAD_LAPTOP_SPECTRUM_KBD_BL_CHANGED,
 };
 
 int ideapad_laptop_register_notifier(struct notifier_block *nb);
-- 
2.55.0

