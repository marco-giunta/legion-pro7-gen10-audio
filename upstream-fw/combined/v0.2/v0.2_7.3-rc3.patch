diff -rupN linux-7.3-rc3/sound/hda/codecs/side-codecs/aw88399_hda.c linux-7.3-rc3_fw_patch/sound/hda/codecs/side-codecs/aw88399_hda.c
--- linux-7.3-rc3/sound/hda/codecs/side-codecs/aw88399_hda.c	2026-09-13 23:38:02.000000000 +0200
+++ linux-7.3-rc3_fw_patch/sound/hda/codecs/side-codecs/aw88399_hda.c	2026-09-14 16:51:22.764656609 +0200
@@ -130,10 +130,22 @@ static int aw88399_hda_init(struct aw883
 	if (core->aw_pa)
 		aw88399_dev_set_channel(core, aw88399->channel);
 
-	ret = aw88399_request_firmware_file(core);
+	if (!aw88399->acpi_subsystem_id) {
+		dev_err(dev, "Cannot load firmware: ACPI subsystem ID not available\n");
+		return -ENODEV;
+	}
+
+	char *fw_name __free(kfree) =
+		kasprintf(GFP_KERNEL, "awinic/aw88399_acf_%s.bin", aw88399->acpi_subsystem_id);
+	if (!fw_name)
+		return -ENOMEM;
+	string_lower(fw_name, fw_name);
+	ret = aw88399_request_firmware_file(core, fw_name);
 	if (ret)
 		return ret;
 
+	dev_info(dev, "Loaded firmware %s\n", fw_name);
+
 	aw88399->core = core;
 	aw88399->aw_dev = core->aw_pa;
 
@@ -370,4 +382,4 @@ MODULE_DESCRIPTION("AW88399 HDA driver")
 MODULE_AUTHOR("Yakov Till <yakov.till@gmail.com>");
 MODULE_AUTHOR("Marco Giunta <marco_giunta@outlook.it>");
 MODULE_LICENSE("GPL");
-MODULE_FIRMWARE("aw88399_acf.bin");
+MODULE_FIRMWARE("awinic/aw88399_acf_*.bin");
