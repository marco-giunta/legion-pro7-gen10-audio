From 070208a12f9e266ba656d3518caaf449a34df338 Mon Sep 17 00:00:00 2001
From: Marco Giunta <marco_giunta@outlook.it>
Date: Wed, 26 Aug 2026 23:28:54 +0200
Subject: [PATCH 2/2] ALSA: hda: aw88399: use SSID-specific firmware name

Use the ACPI subsystem ID to construct a per-model firmware
filename (e.g. "awinic/aw88399_acf_17aa3938.bin") when loading
firmware on HDA systems. This makes the driver compatible with
the linux-firmware repository's per-device naming convention.

Signed-off-by: Marco Giunta <marco_giunta@outlook.it>
---
 sound/hda/codecs/side-codecs/aw88399_hda.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/sound/hda/codecs/side-codecs/aw88399_hda.c b/sound/hda/codecs/side-codecs/aw88399_hda.c
index 74ec9b683302..7616229cd775 100644
--- a/sound/hda/codecs/side-codecs/aw88399_hda.c
+++ b/sound/hda/codecs/side-codecs/aw88399_hda.c
@@ -110,6 +110,7 @@ static int aw88399_hda_init(struct aw88399_hda *aw88399)
 	struct i2c_client *i2c = to_i2c_client(dev);
 	struct aw88399 *core;
 	int ret;
+	char *fw_name;
 
 	core = devm_kzalloc(dev, sizeof(*core), GFP_KERNEL);
 	if (!core)
@@ -130,7 +131,19 @@ static int aw88399_hda_init(struct aw88399_hda *aw88399)
 	if (core->aw_pa)
 		aw88399_dev_set_channel(core, aw88399->channel);
 
-	ret = aw88399_request_firmware_file(core, AW88399_ACF_FILE);
+	if (!aw88399->acpi_subsystem_id) {
+		dev_err(dev, "Cannot load firmware: ACPI subsystem ID not available\n");
+		return -ENODEV;
+	}
+
+	fw_name = kasprintf(GFP_KERNEL, "awinic/aw88399_acf_%s.bin",
+			    aw88399->acpi_subsystem_id);
+	if (!fw_name)
+		return -ENOMEM;
+	string_lower(fw_name, fw_name);
+	ret = aw88399_request_firmware_file(core, fw_name);
+	kfree(fw_name);
+
 	if (ret)
 		return ret;
 
@@ -370,4 +383,4 @@ MODULE_DESCRIPTION("AW88399 HDA driver");
 MODULE_AUTHOR("Yakov Till <yakov.till@gmail.com>");
 MODULE_AUTHOR("Marco Giunta <marco_giunta@outlook.it>");
 MODULE_LICENSE("GPL");
-MODULE_FIRMWARE("aw88399_acf.bin");
+MODULE_FIRMWARE("awinic/aw88399_acf_*.bin");
-- 
